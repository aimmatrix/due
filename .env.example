# Copy to .env.local. Never commit real values.
# --- Stripe (TEST MODE ONLY — live keys are refused at startup) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Inbound events (/api/events/*) ---
INGEST_TOKEN=replace_with_long_random_token
# Typed by the person submitting the service-completion form at /forms/completion
FORM_ACCESS_CODE=replace_me

# --- LLM structured extraction ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Runtime ---
DATABASE_PATH=data/due.db
DEMO_MODE=true
APP_BASE_URL=http://localhost:3000
PORT=3000

# --- Adapter modes: fake (default) or real. Only the integration checkout uses real external sends. ---
ADAPTER_STRIPE=fake
ADAPTER_LLM=fake
ADAPTER_MEMORY=fake
ADAPTER_EMAIL=fake
ADAPTER_VOICE=fake

# --- Cognee (P1 memory) ---
COGNEE_API_URL=
COGNEE_API_KEY=

# --- Reminder email (team-controlled destination only) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
REMINDER_FROM_EMAIL=
DEMO_EMAIL_ALLOWLIST=

# --- ElevenLabs outbound calls (teammate B1) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Optional override; defaults to DEMO_PHONE_ALLOWLIST below
VOICE_DEMO_ALLOWLIST=
# Consenting teammate numbers only, E.164, comma separated
DEMO_PHONE_ALLOWLIST=
