{
  "name": "due",
  "version": "0.1.0",
  "private": true,
  "description": "AI accounts-receivable agent: completed work to collected payment (Briefcase x Stripe hackathon).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-3000}",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "tsx --env-file-if-exists=.env.local scripts/check-env.ts",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "e2e:stripe": "node --env-file=.env.local --import tsx scripts/e2e-a0-05.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "better-sqlite3": "13.0.3",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
